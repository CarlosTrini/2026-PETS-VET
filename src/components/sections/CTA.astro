---
// CTA.astro — Mid-page call to action banner
import { clinicInfo } from "../../data/clinic";
---

<section
  aria-label="Llamada a la acción — Agenda tu consulta"
  class="py-20 bg-secondary relative overflow-hidden"
>
  <!-- Decorative blobs -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div
      class="absolute top-0 left-1/4 w-96 h-96 rounded-full bg-primary/15 blur-3xl -translate-y-1/2"
    >
    </div>
    <div
      class="absolute bottom-0 right-1/4 w-64 h-64 rounded-full bg-accent/10 blur-3xl translate-y-1/2"
    >
    </div>
    <!-- Paw decorations -->
    <svg
      class="absolute right-8 top-8 w-24 h-24 text-surface/5"
      viewBox="0 0 100 100"
      fill="currentColor"
      aria-hidden="true"
    >
      <ellipse cx="30" cy="20" rx="12" ry="16"></ellipse><ellipse
        cx="70"
        cy="20"
        rx="12"
        ry="16"></ellipse>
      <ellipse cx="15" cy="50" rx="10" ry="14"></ellipse><ellipse
        cx="85"
        cy="50"
        rx="10"
        ry="14"></ellipse>
      <ellipse cx="50" cy="70" rx="22" ry="28"></ellipse>
    </svg>
    <svg
      class="absolute left-8 bottom-8 w-16 h-16 text-surface/5"
      viewBox="0 0 100 100"
      fill="currentColor"
      aria-hidden="true"
    >
      <ellipse cx="30" cy="20" rx="12" ry="16"></ellipse><ellipse
        cx="70"
        cy="20"
        rx="12"
        ry="16"></ellipse>
      <ellipse cx="15" cy="50" rx="10" ry="14"></ellipse><ellipse
        cx="85"
        cy="50"
        rx="10"
        ry="14"></ellipse>
      <ellipse cx="50" cy="70" rx="22" ry="28"></ellipse>
    </svg>
  </div>

  <div
    class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-surface"
  >
    <div
      class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 px-4 py-2 rounded-full text-sm font-medium mb-6"
      aria-hidden="true"
    >
      <span class="w-2 h-2 rounded-full bg-accent inline-block animate-pulse"
      ></span>
      Atendemos hoy · Lun–Dom 10am–7pm
    </div>

    <h2
      class="font-display font-extrabold text-3xl sm:text-4xl lg:text-5xl mb-5 leading-tight"
    >
      La salud de tu mascota<br /> no puede esperar
    </h2>

    <p class="text-surface/70 text-lg max-w-2xl mx-auto mb-10 leading-relaxed">
      Agenda tu consulta hoy o escríbenos por WhatsApp para una asesoría
      gratuita. Nuestro equipo de especialistas está listo para atenderte.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="#contacto"
        id="cta-mid-agenda"
        class="inline-flex items-center justify-center gap-2.5 bg-primary text-surface font-bold px-8 py-4 rounded-2xl hover:bg-primary-dark transition-all duration-200 shadow-lg hover:shadow-xl hover:-translate-y-0.5 text-base"
        aria-label="Ir a la sección de contacto para agendar"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
          ></path>
        </svg>
        Agendar consulta
      </a>
      <a
        href={clinicInfo.whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        id="cta-mid-whatsapp"
        class="inline-flex items-center justify-center gap-2.5 bg-whatsapp text-surface font-bold px-8 py-4 rounded-2xl hover:bg-whatsapp-dark transition-all duration-200 shadow-lg hover:shadow-xl hover:-translate-y-0.5 text-base"
        aria-label="Contactar por WhatsApp ahora"
      >
        <svg
          viewBox="0 0 24 24"
          class="w-5 h-5 fill-current"
          aria-hidden="true"
        >
          <path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
          ></path>
        </svg>
        Asesoría gratis por WhatsApp
      </a>
    </div>

    <!-- Trust badges -->
    <div
      class="flex flex-wrap items-center justify-center gap-6 mt-10 text-surface/50 text-sm"
    >
      <span class="flex items-center gap-1.5">
        <svg
          class="w-4 h-4 text-primary"
          fill="currentColor"
          viewBox="0 0 20 20"
          aria-hidden="true"
          ><path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
            clip-rule="evenodd"></path></svg
        >
        Sin cita previa
      </span>
      <span class="flex items-center gap-1.5">
        <svg
          class="w-4 h-4 text-primary"
          fill="currentColor"
          viewBox="0 0 20 20"
          aria-hidden="true"
          ><path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
            clip-rule="evenodd"></path></svg
        >
        Respuesta inmediata
      </span>
      <span class="flex items-center gap-1.5">
        <svg
          class="w-4 h-4 text-primary"
          fill="currentColor"
          viewBox="0 0 20 20"
          aria-hidden="true"
          ><path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
            clip-rule="evenodd"></path></svg
        >
        Equipo certificado
      </span>
    </div>
  </div>
</section>
