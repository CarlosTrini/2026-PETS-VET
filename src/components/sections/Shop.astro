---
// Shop.astro — Tienda para mascotas
import { clinicInfo } from '../../data/clinic';

const categories = [
  {
    id: 'ropa',
    title: 'Ropa para Mascotas',
    description: 'Suéteres, impermeables, pijamas y más. ¡Porque tu mascota también merece verse increíble!',
    emoji: '👕',
    badge: 'Tallas XS–XL',
    image: '/images/hero-dog.jpg',
    imageAlt: 'Perro usando un suéter colorido en la tienda de PetsVet',
    whatsappMsg: 'Hola! Me interesa la ropa para mascotas 🐾',
  },
  {
    id: 'alimentos',
    title: 'Alimentos Premium',
    description: 'Croquetas, latas, snacks y dietas terapéuticas seleccionadas por nuestros nutriólogos veterinarios.',
    emoji: '🥩',
    badge: 'Marcas premium',
    image: '/images/service-consultation.jpg',
    imageAlt: 'Variedad de alimentos premium para mascotas en PetsVet',
    whatsappMsg: 'Hola! Me interesa conocer sus alimentos para mascotas 🐾',
  },
  {
    id: 'accesorios',
    title: 'Accesorios & Juguetes',
    description: 'Correas, collares, camas, juguetes interactivos y todo lo que necesitas para el bienestar de tu compañero.',
    emoji: '🎾',
    badge: 'Gran variedad',
    image: '/images/hero-cat.jpg',
    imageAlt: 'Accesorios y juguetes para mascotas en nuestra tienda',
    whatsappMsg: 'Hola! Me interesan sus accesorios y juguetes para mascotas 🐾',
  },
];
---

<section
  id="tienda"
  aria-labelledby="shop-heading"
  class="py-24 bg-surface"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-16">
      <div class="section-chip" aria-hidden="true">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
        </svg>
        Tienda especializada
      </div>
      <h2 id="shop-heading" class="font-display font-extrabold text-4xl sm:text-5xl text-text mt-2 mb-4">
        Todo para tu mascota,<br/> en un solo lugar
      </h2>
      <p class="text-text-muted text-lg max-w-2xl mx-auto">
        Contamos con una tienda especializada con productos seleccionados por nuestros veterinarios. Pide por WhatsApp y te asesoramos en tu elección.
      </p>
    </div>

    <!-- Category cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      {categories.map(cat => (
        <article
          class="group bg-white rounded-3xl overflow-hidden border border-slate-100 card-hover"
          aria-label={`Categoría: ${cat.title}`}
        >
          <!-- Image -->
          <div class="relative aspect-4/3 overflow-hidden">
            <img
              src={cat.image}
              alt={cat.imageAlt}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              width="400"
              height="300"
              loading="lazy"
            />
            <!-- Overlay -->
            <div class="absolute inset-0 bg-linear-to-t from-black/40 to-transparent"></div>
            <!-- Badge -->
            <div class="absolute top-3 right-3 bg-accent text-secondary text-xs font-bold px-3 py-1 rounded-full">
              {cat.badge}
            </div>
            <!-- Emoji -->
            <div class="absolute top-3 left-3 w-10 h-10 rounded-xl bg-white/90 flex items-center justify-center text-xl" aria-hidden="true">
              {cat.emoji}
            </div>
          </div>

          <!-- Content -->
          <div class="p-6">
            <h3 class="font-display font-bold text-xl text-text mb-2">{cat.title}</h3>
            <p class="text-text-muted text-sm leading-relaxed mb-5">{cat.description}</p>
            <a
              href={`${clinicInfo.whatsappLink.replace('text=Hola%2C%20me%20gustar%C3%ADa%20agendar%20una%20consulta%20para%20mi%20mascota.', `text=${encodeURIComponent(cat.whatsappMsg)}`)}`}
              target="_blank"
              rel="noopener noreferrer"
              id={`shop-cta-${cat.id}`}
              class="flex items-center justify-center gap-2 bg-whatsapp text-surface font-semibold py-2.5 px-4 rounded-xl hover:bg-whatsapp-dark transition-colors text-sm"
              aria-label={`Pedir ${cat.title} por WhatsApp`}
            >
              <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              Pedir por WhatsApp
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Info banner -->
    <div class="bg-linear-to-r from-primary to-primary-dark rounded-3xl p-8 text-surface text-center">
      <p class="font-display font-bold text-xl sm:text-2xl mb-2">
        🐾 ¿No encuentras lo que buscas?
      </p>
      <p class="text-surface/80 mb-5 max-w-lg mx-auto text-sm sm:text-base">
        Escríbenos por WhatsApp y nuestros veterinarios te recomiendan el producto ideal para las necesidades de tu mascota.
      </p>
      <a
        href={clinicInfo.whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        id="shop-general-cta"
        class="inline-flex items-center gap-2.5 bg-white text-primary font-bold px-7 py-3.5 rounded-2xl hover:bg-white/90 transition-colors shadow-md"
        aria-label="Consultar catálogo por WhatsApp"
      >
        Consultar catálogo completo
      </a>
    </div>
  </div>
</section>
