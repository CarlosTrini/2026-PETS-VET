---
// Testimonials.astro
import { testimonials } from '../../data/testimonials';
---

<section
  id="testimonios"
  aria-labelledby="testimonials-heading"
  class="py-24 bg-white"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-16">
      <div class="section-chip" aria-hidden="true">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        Lo que dicen nuestros clientes
      </div>
      <h2 id="testimonials-heading" class="font-display font-extrabold text-4xl sm:text-5xl text-text mt-2 mb-4">
        Ellos ya confían en nosotros
      </h2>
      <p class="text-text-muted text-lg max-w-xl mx-auto">
        Más de 200 familias en Texcoco y alrededores nos han dado su confianza. Aquí algunos de sus testimonios.
      </p>
    </div>

    <!-- Testimonials grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {testimonials.map((t, i) => (
        <article
          class={`bg-surface rounded-3xl p-6 border border-slate-100 card-hover
            ${i === 0 ? 'lg:col-span-2' : ''}
          `}
          aria-label={`Reseña de ${t.name}`}
        >
          <!-- Stars -->
          <div class="flex text-accent text-lg mb-4" aria-label={`${t.rating} de 5 estrellas`}>
            {'★'.repeat(t.rating)}
            <span class="sr-only">{t.rating} de 5 estrellas</span>
          </div>

          <!-- Quote -->
          <blockquote class="text-text text-sm sm:text-base leading-relaxed mb-6">
            "{t.text}"
          </blockquote>

          <!-- Author -->
          <div class="flex items-center gap-3 pt-4 border-t border-slate-200">
            <div class="w-10 h-10 rounded-full overflow-hidden border-2 border-primary/20">
              <img
                src={t.image}
                alt={t.imageAlt}
                class="w-full h-full object-cover"
                width="40"
                height="40"
                loading="lazy"
              />
            </div>
            <div>
              <p class="font-semibold text-sm text-text">{t.name}</p>
              <p class="text-xs text-text-muted">Dueño/a de <span class="text-primary">{t.petName}</span> · {t.petType}</p>
            </div>
            <!-- Google G icon -->
            <div class="ml-auto" aria-label="Reseña de Google">
              <svg viewBox="0 0 24 24" class="w-6 h-6" aria-hidden="true">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
              </svg>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Google CTA -->
    <div class="text-center mt-12">
      <a
        href="https://maps.google.com"
        target="_blank"
        rel="noopener noreferrer"
        id="google-reviews-cta"
        class="inline-flex items-center gap-2.5 border-2 border-slate-200 text-text font-semibold px-6 py-3 rounded-2xl hover:border-primary hover:text-primary transition-all duration-200"
        aria-label="Ver todas las reseñas en Google"
      >
        <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        Ver todas nuestras reseñas en Google
      </a>
    </div>
  </div>
</section>
