---
// FAQ.astro — Preguntas frecuentes con Schema.org FAQPage
import { faqItems } from '../../data/faq';

// FAQPage Schema for Google rich snippets
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<section
  id="faq"
  aria-labelledby="faq-heading"
  class="py-24 bg-surface"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-16">
      <div class="section-chip" aria-hidden="true">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Preguntas frecuentes
      </div>
      <h2 id="faq-heading" class="font-display font-extrabold text-4xl sm:text-5xl text-text mt-2 mb-4">
        Todo lo que necesitas saber
      </h2>
      <p class="text-text-muted text-lg max-w-xl mx-auto">
        ¿Tienes alguna duda? Aquí respondemos las más comunes. Si no encuentras tu respuesta, escríbenos.
      </p>
    </div>

    <!-- FAQ Accordion -->
    <div class="space-y-3" role="list" aria-label="Preguntas frecuentes">
      {faqItems.map((item, i) => (
        <details
          class="group bg-white rounded-2xl border border-slate-100 overflow-hidden hover:border-primary/30 transition-colors"
          role="listitem"
        >
          <summary
            class="flex items-center justify-between gap-4 p-6 cursor-pointer font-semibold text-text text-base list-none hover:text-primary transition-colors"
            id={`faq-q-${item.id}`}
            aria-expanded="false"
          >
            <span class="flex items-start gap-3">
              <span class="shrink-0 w-7 h-7 rounded-lg bg-primary-light text-primary text-xs font-bold flex items-center justify-center mt-0.5" aria-hidden="true">
                {i + 1}
              </span>
              {item.question}
            </span>
            <!-- Chevron icon -->
            <span class="shrink-0 w-6 h-6 rounded-full border-2 border-slate-200 group-open:border-primary flex items-center justify-center transition-colors" aria-hidden="true">
              <svg class="w-3 h-3 text-text-muted group-open:text-primary group-open:rotate-180 transition-all duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </span>
          </summary>
          <div
            class="px-6 pb-6"
            id={`faq-a-${item.id}`}
          >
            <div class="pl-10 text-text-muted text-sm leading-relaxed border-l-2 border-primary/20">
              {item.answer}
            </div>
          </div>
        </details>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="mt-12 text-center">
      <p class="text-text-muted mb-4">¿No encontraste tu respuesta?</p>
      <a
        href="https://wa.me/5255874236 91?text=Hola%2C%20tengo%20una%20pregunta%20sobre%20PetsVet"
        target="_blank"
        rel="noopener noreferrer"
        id="faq-whatsapp-cta"
        class="inline-flex items-center gap-2.5 bg-whatsapp text-surface font-semibold px-7 py-3.5 rounded-2xl hover:bg-whatsapp-dark transition-colors shadow-sm"
        aria-label="Hacer una pregunta por WhatsApp"
      >
        <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        Pregúntanos por WhatsApp
      </a>
    </div>
  </div>

  <!-- FAQPage Schema JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
