---
// Header.astro — Navegación sticky con links a secciones
import { clinicInfo } from "../../data/clinic";
import MobileMenuToggle from "../react/MobileMenuToggle";

const navLinks = [
  { href: "#inicio", label: "Inicio" },
  { href: "#servicios", label: "Servicios" },
  { href: "#nosotros", label: "Nosotros" },
  { href: "#testimonios", label: "Reseñas" },
  { href: "#tienda", label: "Tienda" },
  { href: "#contacto", label: "Contacto" },
];
---

<header
  id="main-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  data-scroll-header
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a
        href="#inicio"
        class="flex items-center gap-2.5 group"
        aria-label="PetsVet - Ir al inicio"
      >
        <div
          class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center shadow-md group-hover:scale-105 transition-transform"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="white"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-6 h-6"
            aria-hidden="true"
          >
            <path
              d="M10 5.172C10 3.782 8.423 2.679 6.5 3c-2.823.47-4.113 6.006-4 7 .08.703 1.725 1.722 3.656 1 1.261-.472 1.96-1.45 2.344-2.5"
            ></path>
            <path
              d="M14.267 5.172c0-1.39 1.577-2.493 3.5-2.172 2.823.47 4.113 6.006 4 7-.08.703-1.725 1.722-3.656 1-1.261-.472-1.96-1.45-2.344-2.5"
            ></path>
            <path d="M8 14v.5"></path>
            <path d="M16 14v.5"></path>
            <path d="M11.25 16.25h1.5L12 17l-.75-.75z"></path>
            <path
              d="M4.42 11.247A13.152 13.152 0 0 0 4 14.556C4 18.728 7.582 21 12 21s8-2.272 8-6.444c0-1.061-.162-2.2-.493-3.309m-9.243-6.082A8.801 8.801 0 0 1 12 5c.78 0 1.5.108 2.161.306"
            ></path>
          </svg>
        </div>
        <div class="flex flex-col leading-tight">
          <span
            class="font-display font-800 text-xl text-secondary tracking-tight"
          >
            Pets<span class="text-primary">Vet</span>
          </span>
          <span
            class="text-[10px] text-text-muted font-medium tracking-widest uppercase leading-none"
            >Clínica Veterinaria</span
          >
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav aria-label="Navegación principal" class="hidden lg:block">
        <ul class="flex items-center gap-1">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="px-4 py-2 rounded-lg text-sm font-medium text-text hover:text-primary hover:bg-primary-light transition-all duration-200"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Desktop CTA -->
      <div class="hidden lg:flex items-center gap-3">
        <a
          href={`tel:${clinicInfo.phone.replace(/\s/g, "")}`}
          class="flex items-center gap-1.5 text-sm text-text-muted hover:text-primary transition-colors font-medium"
          aria-label={`Llamar al ${clinicInfo.phone}`}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.44 2 2 0 0 1 3.55 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.72a16 16 0 0 0 5.37 5.37l.89-.89a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
            ></path>
          </svg>
          {clinicInfo.phone}
        </a>
        <a
          href={clinicInfo.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          id="header-whatsapp-cta"
          class="flex items-center gap-2 bg-whatsapp text-white px-4 py-2 rounded-xl text-sm font-semibold hover:bg-whatsapp-dark transition-all duration-200 shadow-sm hover:shadow-md"
          aria-label="Contactar por WhatsApp"
        >
          <svg
            viewBox="0 0 24 24"
            class="w-4 h-4 fill-current"
            aria-hidden="true"
          >
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
            ></path>
          </svg>
          WhatsApp
        </a>
      </div>

      <!-- Mobile Menu Toggle (React Island) -->
      <MobileMenuToggle
        navLinks={navLinks}
        whatsappLink={clinicInfo.whatsappLink}
        client:load
      />
    </div>
  </div>
</header>

<script>
  // Header scroll effect
  const header = document.querySelector("[data-scroll-header]") as HTMLElement;

  function updateHeader() {
    if (window.scrollY > 20) {
      header.classList.add(
        "bg-white/95",
        "backdrop-blur-md",
        "shadow-sm",
        "border-b",
        "border-slate-100",
      );
    } else {
      header.classList.remove(
        "bg-white/95",
        "backdrop-blur-md",
        "shadow-sm",
        "border-b",
        "border-slate-100",
      );
    }
  }

  window.addEventListener("scroll", updateHeader, { passive: true });
  updateHeader();
</script>
